+using Avalonia.Platform;
+using System;
+using System.Diagnostics;
+using System.Text.Json;
+
+namespace Apps2Samsung.Helpers
+{
+    /// <summary>
+    /// Optional per-person build preset, read from Assets/preset.json (only present in
+    /// custom builds). Preselects the Jellyfin release asset, pins the Jellyfin server
+    /// address written into the TV app, labels the window and turns off the update check
+    /// so the custom build isn't replaced by a stock one.
+    /// </summary>
+    public sealed class Preset
+    {
+        private static readonly Uri PresetUri = new("avares://Apps2Samsung/Assets/preset.json");
+
+        public string? Title { get; set; }
+        public string? AssetName { get; set; }
+        public string? JellyfinServerUrl { get; set; }
+
+        public static Preset? Current { get; private set; }
+
+        public static void Load()
+        {
+            try
+            {
+                if (!AssetLoader.Exists(PresetUri))
+                    return;
+
+                using var stream = AssetLoader.Open(PresetUri);
+                Current = JsonSerializer.Deserialize<Preset>(stream,
+                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
+                Trace.WriteLine($"[Preset] loaded: asset={Current?.AssetName} server={Current?.JellyfinServerUrl}");
+            }
+            catch (Exception ex)
+            {
+                Trace.WriteLine($"[Preset] failed to load: {ex.Message}");
+                Current = null;
+            }
+        }
+
+        public static void ApplyTo(AppSettings settings)
+        {
+            if (Current == null)
+                return;
+
+            if (!string.IsNullOrWhiteSpace(Current.JellyfinServerUrl))
+            {
+                settings.JellyfinIP = Current.JellyfinServerUrl.TrimEnd('/');
+                settings.JellyfinBasePath = "";
+                settings.ServerInputMode = "Full URL";
+            }
+
+            settings.CheckForUpdatesOnStartup = false;
+            settings.Save();
+        }
+    }
+}
